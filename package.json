{
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/build-static.mjs && node scripts/verify-static.mjs",
    "deploy": "wrangler deploy",
    "lighthouse:verify": "lighthouse verify",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test tests/*.test.mjs && node scripts/test-build-failures.mjs && playwright test",
    "verify": "npm run lighthouse:verify && npm run build && npm test",
    "serve:static": "node scripts/serve-static.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@juangcarmona/lighthouse": "0.11.6",
    "@juangcarmona/lighthouse-sdlc": "0.15.2",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wrangler": "4.154.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "name": "presentations",
  "type": "module"
}
