{
  "$schema": "./node_modules/@juangcarmona/lighthouse/assets/schemas/lighthouse-manifest.schema.json",
  "schemaVersion": 1,
  "baseline": "0.1.0",
  "product": "presentations",
  "application": {
    "shape": "frontend",
    "stacks": [
      "react",
      "typescript"
    ]
  },
  "profiles": [
    "visual-theme"
  ],
  "integrations": {
    "productShape": null,
    "arcShape": null
  },
  "packages": {
    "sdlc": {
      "name": "@juangcarmona/lighthouse-sdlc",
      "version": "0.12.0"
    },
    "ui": {
      "name": "@juangcarmona/lighthouse-ui",
      "version": "0.2.0"
    }
  },
  "managed": [
    "LIGHTHOUSE.md",
    "scripts/lighthouse-guard.mjs",
    ".husky/commit-msg",
    ".husky/pre-push",
    ".github/workflows/lighthouse.yml",
    ".lighthouse/sdlc.json",
    ".agents/skills/lighthouse-init/SKILL.md",
    ".lighthouse/upgrade.json",
    ".lighthouse/commands.json",
    "docs/design/DESIGN.md",
    ".agents/skills/lighthouse-ui/SKILL.md"
  ],
  "repository": {
    "layout": [
      "src",
      "docs",
      "infra",
      "scripts"
    ],
    "publicSite": {
      "enabled": true
    },
    "conventions": {
      "commits": "conventional",
      "branchPattern": "^(feat|fix|docs|refactor|test|chore|build|ci|perf|revert)/[1-9]\\d*-[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
